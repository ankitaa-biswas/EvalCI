# evalci/.env.example
# Purpose: Template for all environment variables required by EvalCI.
# Copy this file to .env and fill in your actual credentials before running.
#
# NEVER commit your actual .env file — it contains secrets.
# .env is already in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values
#   docker compose up -d       # start infrastructure
#   uvicorn api.main:app --reload --port 8080
#   celery -A core.queue.celery_app worker --loglevel=info

# ──────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://evalci:evalci@localhost:5432/evalci

# Set SQL_ECHO=true to log all SQL statements (development only)
SQL_ECHO=false

# ──────────────────────────────────────────────────────────────
# Redis (broker + cache + pub/sub)
# ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# How long to cache per-question scores (seconds). Default: 7 days
CACHE_TTL_SECONDS=604800

# ──────────────────────────────────────────────────────────────
# LLM API Keys (Google Gemini - Free Tier)
# ──────────────────────────────────────────────────────────────
# Get your free key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...your-key-here...

# Which Gemini model to use for generation (and Ragas LLM-as-judge)
OPENAI_MODEL=gemini-1.5-flash

# ──────────────────────────────────────────────────────────────
# RAG system configuration
# ──────────────────────────────────────────────────────────────
# ChromaDB vector store connection
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=evalci_docs

# Number of document chunks to retrieve per question
RAG_TOP_K=5

# Document chunking parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Optional: Override RAG endpoint URL (used for external RAG service eval)
# RAG_ENDPOINT=http://your-rag-service/query

# ──────────────────────────────────────────────────────────────
# Evaluation thresholds
# ──────────────────────────────────────────────────────────────
# Minimum overall score to pass a run (0.0 – 1.0)
PASS_THRESHOLD=0.70

# Regression fingerprint sensitivity thresholds
GROUNDING_REGRESSION_THRESHOLD=0.05
CORRECTNESS_REGRESSION_THRESHOLD=0.05
CONTEXT_RECALL_THRESHOLD=0.05

# ──────────────────────────────────────────────────────────────
# API security (Cycle 2)
# ──────────────────────────────────────────────────────────────
# Bearer token required by the GitHub Actions workflow
# EVALCI_API_KEY=your-secret-api-key

# ──────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────
# FastAPI app host and port
APP_HOST=0.0.0.0
APP_PORT=8080

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
