# Copy to a private env file and replace placeholders. Do not commit that file.
# Compose supplies internal service hostnames; do not use localhost between containers.
POSTGRES_PASSWORD=replace-with-a-local-password
EVALCI_API_KEYS=replace-with-a-local-api-key
API_PORT=8080
RAG_PORT=8001
EVAL_SCORING_MODE=ragas
EVAL_JUDGE_MODEL=replace-with-an-available-judge-model
EVAL_EMBEDDING_MODEL=replace-with-an-available-embedding-model
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_BASE_URL=https://api.openai.com/v1
EVAL_SCORING_BATCH_SIZE=5
RAG_REQUEST_TIMEOUT_SECONDS=30
RAG_MODE=live
GOOGLE_API_KEY=replace-with-your-google-provider-key
GEMINI_GENERATION_MODEL=replace-with-an-available-generation-model
GEMINI_EMBEDDING_MODEL=replace-with-an-available-embedding-model
PASS_THRESHOLD=0.70
